{
  "name": "create360-content-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for reading Create360-backed content sources such as SETN, CTITV, and Bestshop.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format": "oxfmt --no-error-on-unmatched-pattern --config ./.oxfmtrc.json",
    "lint": "oxlint src --type-aware --fix",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.54.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
