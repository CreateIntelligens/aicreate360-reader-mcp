{
  "name": "aicreate360-reader-mcp",
  "version": "1.0.0",
  "description": "MCP server that fetches any public URL as clean markdown via create360.ai.",
  "keywords": [
    "ai",
    "create360",
    "markdown",
    "mcp",
    "model-context-protocol",
    "url-fetcher",
    "web-scraper"
  ],
  "homepage": "https://github.com/CreateIntelligens/aicreate360-reader-mcp#readme",
  "bugs": {
    "url": "https://github.com/CreateIntelligens/aicreate360-reader-mcp/issues"
  },
  "license": "MIT",
  "author": "john-chen-aicreate360",
  "repository": {
    "type": "git",
    "url": "https://github.com/CreateIntelligens/aicreate360-reader-mcp.git"
  },
  "bin": {
    "aicreate360-reader-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "commit": "git-cz",
    "commitlint": "commitlint",
    "dev": "tsx src/index.ts",
    "format": "oxfmt . --no-error-on-unmatched-pattern --config ./.oxfmtrc.json",
    "lint": "oxlint src --type-aware --fix",
    "lint-staged": "lint-staged",
    "lint:check": "oxlint src --type-aware",
    "prepare": "husky",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/cz-commitlint": "^20.5.0",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.0",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,json,md}": [
      "oxfmt --config ./.oxfmtrc.json"
    ],
    "src/**/*.ts": [
      "oxlint --type-aware --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "vitest": {
    "environment": "node",
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "html"
      ],
      "include": [
        "src/**/*.ts"
      ],
      "exclude": [
        "src/index.ts",
        "src/types.ts"
      ],
      "thresholds": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    }
  }
}
